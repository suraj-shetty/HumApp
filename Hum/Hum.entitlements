<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- UNUSED — no longer referenced by the build (CODE_SIGN_ENTITLEMENTS was
	     removed from project.yml).

	     This file previously declared `com.apple.developer.musickit`, which is
	     not a real entitlement. MusicKit on iOS is enabled as an App Service on
	     the App ID in the developer portal; the app itself needs only
	     NSAppleMusicUsageDescription plus runtime MusicAuthorization. Declaring
	     the key failed provisioning with "Entitlement com.apple.developer.musickit
	     not found and could not be included in profile."

	     Kept as an empty placeholder for a future real entitlement (e.g. app
	     groups). Safe to delete. -->
</dict>
</plist>
